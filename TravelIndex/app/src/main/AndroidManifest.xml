<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permisos mínimos. Sin internet: la app no se conecta a ningún servidor. Fotos y archivos se importan con selectores del sistema (sin permisos de almacenamiento). -->
    <!-- La cámara es opcional: la foto de un documento la hace la app de cámara del sistema (no hace falta el permiso CAMERA)
         y los móviles sin cámara pueden instalar la app igualmente. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Mostrar los recordatorios que el usuario programa (Android 13+ lo pide en tiempo de ejecución). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Volver a programar los recordatorios tras reiniciar el teléfono. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".TravelIndexApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.TravelIndex.Splash">

        <!-- singleTask: la app tiene una sola instancia. Al abrir un archivo .travelindex desde otra app
             (WhatsApp, correo...), Android no crea una copia dentro de esa app: trae la Travel Index ya abierta
             (o la arranca) y le entrega el archivo por onNewIntent, con la ventana de importación delante. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Abrir un viaje compartido (archivo .travelindex) desde el gestor de archivos, el correo o la mensajería.
                 1) Con el tipo propio de Travel Index. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/vnd.travelindex.trip" />
            </intent-filter>
            <!-- 2) Por el nombre del archivo (cuando la otra app no manda el tipo): acaba en .travelindex. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.travelindex" />
                <data android:pathPattern=".*\\..*\\.travelindex" />
                <data android:pathPattern=".*\\..*\\..*\\.travelindex" />
            </intent-filter>
            <!-- 3) Tipo genérico: algunas apps (p. ej. mensajería) entregan los archivos desconocidos así.
                 Si el archivo no es un viaje, la app lo dice y no importa nada. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <!-- Compartir el archivo de un viaje "hacia" Travel Index desde otra app. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.travelindex.trip" />
            </intent-filter>
        </activity>

        <!-- Widget «Próximo evento» de la pantalla de inicio. El sistema le habla por componente explícito. -->
        <receiver
            android:name=".widget.NextEventWidget"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_next_event_info" />
        </receiver>

        <!-- Recibe las alarmas que programa la propia app: no es accesible desde otras apps. -->
        <receiver
            android:name=".reminders.ReminderReceiver"
            android:exported="false" />

        <!-- Solo reacciona a difusiones protegidas del sistema (arranque del dispositivo y actualización de la app). -->
        <receiver
            android:name=".reminders.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Permite abrir y compartir un archivo concreto con otra app, sin exponer el resto del almacenamiento. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
