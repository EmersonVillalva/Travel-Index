    <!-- About -->
    <string name="about_title">About Travel Index</string>
    <string name="about_version">Version</string>
    <string name="about_package">Package</string>
    <string name="about_author">Made by</string>
    <string name="author_name">Emerson Villalva Labrador</string>
    <string name="made_by">Made by Emerson Villalva Labrador</string>
    <string name="about_description">All your trips in one place: flights, accommodation, activities, travel documents and calendar, stored on your device and available offline.</string>
    <string name="about_highlights_title">What it includes</string>
    <string name="about_highlights">Global search and flights with date, times, duration and what you paid at a glance; accommodation, activities with their duration (the end time is worked out for you), transport and restaurants. Visas and documents with expiry warnings. Files grouped by section, with previews and a built-in viewer: pick them from your device or scan them with automatic cropping. Itinerary and calendar. What you paid on each trip, by category, plus the history of your past trips. Export the whole trip to PDF. Share a trip as an exact copy.</string>
    <string name="about_limits_title">What it doesn\'t do</string>
    <string name="about_limits">No accounts and no cloud sync. It never connects to the internet. It doesn\'t convert between currencies. There\'s no street map: it draws each flight\'s route. Reminders use Android\'s approximate alarms, so they can run a few minutes late. It doesn\'t check delays or cancellations: you enter the flight details yourself. The PDF summarises the trip, with document numbers masked, and doesn\'t include your attached files.</string>

    <!-- Privacy policy -->
    <string name="privacy_intro">Travel Index works without an account and without a connection. This is exactly what the app does with your data.</string>
    <string name="privacy_h_data">Your data</string>
    <string name="privacy_b_data">Everything you type (trips, bookings, document details) is stored only on this device, in the app\'s private storage. The developer doesn\'t receive and can\'t see that information.</string>
    <string name="privacy_h_network">Internet connection</string>
    <string name="privacy_b_network">The app never connects to the internet: it doesn\'t have that permission, uses no analytics, shows no ads and includes no trackers. Only when you open a link is it handled by the browser or app you choose. If you decide to support the project, the app opens a PayPal link in your browser; it\'s optional and the app receives no data about that payment.</string>
    <string name="privacy_h_files">Files and photos</string>
    <string name="privacy_b_files">The files you pick are copied into the app\'s private storage and other apps can\'t access them. “Scan document” uses the Google Play Services scanner, which runs on your device: the document is only stored in the app if you accept it (without Play Services, the system camera is used instead). When you open or share a file, temporary access is granted to the app you choose. If you delete a file or a trip, the copy is deleted.</string>
    <string name="privacy_h_permissions">Permissions</string>
    <string name="privacy_b_permissions">Notifications: to show the alerts your own device schedules. Boot: to re-schedule those alerts when the phone restarts. No internet, location, contacts, camera, microphone or storage permissions are requested: a document photo is taken by the system camera, not by the app.</string>
    <string name="privacy_h_backup">Files you share</string>
    <string name="privacy_b_backup">Android\'s automatic backup is disabled so your data never leaves the device without your say-so. The only files are the ones you create: the “Share trip” file or the trip PDF, which you hand to whoever you choose. Neither is encrypted. The share file can include document and ticket numbers, so send it only to people you trust. The PDF masks visa and travel-document numbers and leaves out their files, but it does include your attached tickets and bookings (with their codes and details), so share it only with whoever really needs it.</string>
    <string name="privacy_h_sensitive">Sensitive details</string>
    <string name="privacy_b_sensitive">Document and ticket numbers are hidden by default. Don\'t store passwords in the app. You can block screenshots in Profile.</string>
    <string name="privacy_h_delete">Deleting your data</string>
    <string name="privacy_b_delete">You can delete individual trips from the app. Uninstalling the app also deletes all its data from the device.</string>
    <string name="privacy_h_contact">Contact</string>
    <string name="privacy_b_contact">If you have privacy questions, you can write to the developer from the Travel Index listing on Google Play.</string>

